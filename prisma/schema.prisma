// ---------------------------------------------------------------------------
// AI-Based Study Coach System
// School of Computing, Informatics and Media Studies
// Mount Kigali University
//
// Entities follow section 3.11 (Database Design Approach) of the project
// documentation.
//
// Production database: PostgreSQL 17, database name "Study-coach".
// (During early development this schema also ran on SQLite; switching the
// provider below back to "sqlite" with url "file:./dev.db" restores that.)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Students, lecturers and administrators share one account table and are
/// distinguished by `role` (STUDENT | LECTURER | ADMIN).
model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         String    @default("STUDENT")
  regNumber    String?   @unique
  yearOfStudy  Int?
  programmeId  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  programme       Programme?       @relation(fields: [programmeId], references: [id])
  enrollments     Enrollment[]
  taughtCourses   Course[]         @relation("CourseLecturer")
  uploadedDocs    Document[]       @relation("DocumentUploader")
  chatSessions    ChatSession[]
  createdQuizzes  Quiz[]           @relation("QuizAuthor")
  quizAttempts    QuizAttempt[]
  studyPlans      StudyPlan[]
  recommendations Recommendation[]
  deadlines       Deadline[]
  events          SystemEvent[]
  resources       Resource[]       @relation("ResourceAuthor")

  @@index([programmeId])
  @@index([role])
}

model Programme {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  durationYears Int     @default(3)

  users   User[]
  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  credits     Int      @default(10)
  yearOfStudy Int      @default(1)
  semester    Int      @default(1)
  programmeId String
  lecturerId  String?
  createdAt   DateTime @default(now())

  programme       Programme        @relation(fields: [programmeId], references: [id])
  lecturer        User?            @relation("CourseLecturer", fields: [lecturerId], references: [id])
  enrollments     Enrollment[]
  documents       Document[]
  quizzes         Quiz[]
  chatSessions    ChatSession[]
  studyPlans      StudyPlan[]
  activities      StudyActivity[]
  recommendations Recommendation[]
  deadlines       Deadline[]
  resources       Resource[]

  @@index([programmeId])
  @@index([lecturerId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

/// An uploaded learning material (lecture notes, handout, past paper).
/// `status` is PROCESSING while text is being extracted, then READY or FAILED.
model Document {
  id           String   @id @default(cuid())
  title        String
  description  String?
  courseId     String
  uploadedById String
  fileName     String
  fileType     String
  fileSize     Int
  pageCount    Int?
  charCount    Int?
  status       String   @default("PROCESSING")
  errorMessage String?
  summary      String?

  /// Teaching position: week of the semester, topic, lecture session number.
  week          Int?
  topic         String?
  sessionNumber Int?

  /// DRAFT | PUBLISHED | ARCHIVED. Students only ever see PUBLISHED material.
  publishState String   @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  chunks     DocumentChunk[]
  quizzes    Quiz[]

  @@index([courseId])
  @@index([courseId, publishState])
}

/// Supplementary learning material that is not a file: a link to a video,
/// an article, a dataset or a tool the lecturer wants students to use.
model Resource {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  url         String
  /// LINK | VIDEO | ARTICLE | TOOL
  kind        String   @default("LINK")
  description String?
  createdById String
  createdAt   DateTime @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ResourceAuthor", fields: [createdById], references: [id])

  @@index([courseId])
}

/// A retrieved-sized section of a document. `embedding` holds a JSON array of
/// floats (pgvector `vector` column once deployed on PostgreSQL). When it is
/// null the retrieval layer falls back to lexical scoring.
model DocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  pageNumber Int?
  embedding  String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ChatSession {
  id        String   @id @default(cuid())
  studentId String
  courseId  String?
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id])
  messages ChatMessage[]

  @@index([studentId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  sources   String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  documentId  String?
  createdById String
  title       String
  description String?
  difficulty  String   @default("MEDIUM")
  createdAt   DateTime @default(now())

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  document  Document?     @relation(fields: [documentId], references: [id])
  createdBy User          @relation("QuizAuthor", fields: [createdById], references: [id])
  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model Question {
  id          String  @id @default(cuid())
  quizId      String
  prompt      String
  options     String
  correctIndex Int
  explanation String?
  topic       String?
  order       Int     @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  studentId   String
  score       Int
  total       Int
  answers     String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
}

model StudyPlan {
  id        String   @id @default(cuid())
  studentId String
  courseId  String?
  title     String
  goal      String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course?         @relation(fields: [courseId], references: [id])
  activities StudyActivity[]

  @@index([studentId])
}

model StudyActivity {
  id              String    @id @default(cuid())
  planId          String
  courseId        String?
  title           String
  scheduledFor    DateTime
  durationMinutes Int       @default(60)
  status          String    @default("PENDING")
  completedAt     DateTime?

  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course Course?   @relation(fields: [courseId], references: [id])

  @@index([planId])
}

model Recommendation {
  id        String   @id @default(cuid())
  studentId String
  courseId  String?
  topic     String
  reason    String
  priority  Int      @default(1)
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])

  @@index([studentId])
}

/// A submission or assessment date the student must work towards:
/// an assignment, a class test, a practical or an examination.
model Deadline {
  id        String   @id @default(cuid())
  studentId String
  courseId  String?
  title     String
  /// ASSIGNMENT | TEST | EXAM | OTHER
  type      String   @default("ASSIGNMENT")
  dueDate   DateTime
  notes     String?
  /// OPEN | DONE
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])

  @@index([studentId, dueDate])
}

/// Audit and diagnostics trail. Written by authentication, the AI layer, the
/// upload pipeline and every administrative action, so the administrator can
/// review failures without reading server logs.
model SystemEvent {
  id        String   @id @default(cuid())
  /// INFO | WARN | ERROR
  level     String   @default("INFO")
  /// AUTH | AI | UPLOAD | ADMIN | SYSTEM
  category  String   @default("SYSTEM")
  message   String
  detail    String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level, createdAt])
  @@index([category])
}
