# Copy this file to .env and fill in your own values.

# PostgreSQL connection string. Replace CHANGE_ME with your postgres password.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/Study-coach?schema=public"

# Any long random string. Used to sign session cookies.
SESSION_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# AI Provider — uncomment ONE block below to activate that provider.
# ---------------------------------------------------------------------------

# --- Option A: Groq (FREE, fast, recommended) ----------------------------
# Get a free key at https://console.groq.com
# AI_PROVIDER=groq
# GROQ_API_KEY=""
# GROQ_CHAT_MODEL="llama-3.1-8b-instant"

# --- Option B: Google Gemini ---------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=""
# GEMINI_CHAT_MODEL="gemini-3.5-flash"
# GEMINI_EMBED_MODEL="gemini-embedding-2"
# GEMINI_THINKING_BUDGET="0"
# GEMINI_EMBED_DIM="768"

# --- Option C: Ollama (FREE, fully local, no internet needed) ------------
# Install from https://ollama.com then run: ollama pull llama3.1
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_CHAT_MODEL="llama3.1"
# OLLAMA_EMBED_MODEL="nomic-embed-text"

# --- Option D: OpenRouter (FREE tier available) ---------------------------
# Get a free key at https://openrouter.ai
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=""
# OPENROUTER_CHAT_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# --- No key / Offline mode -----------------------------------------------
# Leave all keys empty to run in offline demo mode (extractive answers only).
