# Copy this file to .env and fill in your own values.

# PostgreSQL connection string. Replace CHANGE_ME with your postgres password.
DATABASE_URL="postgresql://postgres:12345@localhost:5432/Study-coach?schema=public"

# Any long random string. Used to sign session cookies.
SESSION_SECRET="replace-with-a-long-random-string"

# Google Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run in offline demo mode.
GEMINI_API_KEY=""

# gemini-2.5-flash is no longer issued to new accounts.
# gemini-3.8-flash also works but is much slower (30-90s per answer).
GEMINI_CHAT_MODEL="gemini-3.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-2"

# 0 disables the model's reasoning step (much faster). -1 lets it decide.
GEMINI_THINKING_BUDGET="0"

# Embedding vector size. 768 keeps storage small; the model supports up to 3072.
GEMINI_EMBED_DIM="768"
